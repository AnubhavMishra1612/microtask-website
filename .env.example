# ==============================================================================
# Microtask Platform — Environment Configuration Template (.env.example)
# Use placeholders only. Never commit real credentials to version control.
# ==============================================================================

# ==============================================================================
# Database Configuration (PostgreSQL / Supabase)
# ==============================================================================
# In production (e.g., Supabase / Serverless), use the Connection Pooler URL (Session mode: port 5432 or Transaction mode: port 6543)
# Note: For Supabase Connection Pooler, the user must be scoped to your project reference: postgres.[YOUR-PROJECT-REF]
# Ensure any special characters in the password (e.g. spaces, @, :) are URL-encoded (e.g., %20).
# Add ?connection_limit=5&pool_timeout=30&connect_timeout=30 to prevent connection pool exhaustion and WAN TLS handshake timeouts.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres?connection_limit=5&pool_timeout=30&connect_timeout=30"

# Optional direct connection URL used specifically for CLI migrations (npx prisma migrate deploy)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-DIRECT-HOST]:5432/postgres"

# ==============================================================================
# Environment Mode
# ==============================================================================
# "development" | "production"
NODE_ENV="development"

# ==============================================================================
# Application URL
# ==============================================================================
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# ==============================================================================
# Private Storage Provider Configuration
# ==============================================================================
# Development: "local" (uses ./storage/private_proofs)
# Production (Vercel): "supabase" (REQUIRED - local storage is strictly prohibited in production)
STORAGE_PROVIDER="local"

# Required for Production (Vercel Environment Variables):
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-SECRET-KEY]"
SUPABASE_STORAGE_BUCKET="task-proofs"

# Required when STORAGE_PROVIDER="local" (Local Development Only):
LOCAL_STORAGE_DIR="./storage/private_proofs"

# ==============================================================================
# Initial Admin Credentials (Used by prisma/seed.ts only)
# ==============================================================================
INITIAL_ADMIN_EMAIL="admin@microtask.local"
INITIAL_ADMIN_PASSWORD="[STRONG-INITIAL-ADMIN-PASSWORD]"

# ==============================================================================
# Telegram Integration (Fallback URL when no admin DB override exists)
# ==============================================================================
# Valid format: https://t.me/your_channel or https://t.me/+join_hash
DEFAULT_TELEGRAM_URL="https://t.me/demo_microtask_channel"
